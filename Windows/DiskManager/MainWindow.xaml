<Window x:Class="DiskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskManager"
        Title="DiskManager" Width="1100" Height="720" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="Assets/AppIcon.ico"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" AllowDrop="True">
    <Grid>
        <!-- List of drives -->
        <Grid x:Name="DiskPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" Margin="0,28,0,24">
                <Image Source="Assets/AppIcon.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="DiskManager" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="Find out what’s taking up your disk space." Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="DiskRows" MaxWidth="680" Margin="24,0" />
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18">
                <Button x:Name="ScanFolderButton" Click="ScanFolder_Click" ToolTip="Ctrl+O">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="Scan Folder…" />
                    </StackPanel>
                </Button>
                <TextBlock Text="or drop a folder anywhere in this window" FontSize="11.5"
                           Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <Border x:Name="DropHighlight" Grid.RowSpan="3" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3"
                    CornerRadius="14" Margin="8" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>

        <!-- Scan result -->
        <Grid x:Name="ResultPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="12,0,14,0" LastChildFill="True">
                <Button DockPanel.Dock="Left" Click="BackToDisks_Click" ToolTip="Back to the list of drives (Alt+Left)"
                        Padding="8,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Disks" />
                    </StackPanel>
                </Button>
                <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="More_Click"
                        VerticalAlignment="Center" ToolTip="More">
                    <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                </Button>
                <StackPanel x:Name="AdminLabel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="8,0" Visibility="Collapsed">
                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="Administrator" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <ScrollViewer x:Name="CrumbScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Margin="8,0" VerticalAlignment="Center" Focusable="False">
                    <StackPanel x:Name="Crumbs" Orientation="Horizontal" />
                </ScrollViewer>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:SunburstControl x:Name="Sunburst" Margin="16" />

                    <!-- Collector -->
                    <Grid x:Name="Collector" Grid.Row="1" Height="56" Margin="16,0,16,16" AllowDrop="True">
                        <Border x:Name="CollectorBackground" Background="{StaticResource PanelBrush}" CornerRadius="12" />
                        <Rectangle x:Name="CollectorOutline" RadiusX="12" RadiusY="12" StrokeThickness="1"
                                   Stroke="#22FFFFFF" StrokeDashArray="5 4" />
                        <DockPanel Margin="16,0" LastChildFill="False">
                            <TextBlock x:Name="CollectorIcon" Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                            <TextBlock x:Name="CollectorHint" Text="Drag files and folders here to collect them for deletion."
                                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <StackPanel x:Name="CollectorSummary" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="CollectorSize" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="CollectorCount" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button x:Name="ShowCollectedButton" Content="Show" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="Collapsed" Click="ShowCollected_Click" />
                            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="Delete…" Style="{StaticResource DangerButton}"
                                    VerticalAlignment="Center" Visibility="Collapsed" Click="Delete_Click" />
                            <TextBlock x:Name="DeletingText" DockPanel.Dock="Right" Text="Deleting…" VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                        </DockPanel>
                    </Grid>
                </Grid>

                <!-- Sidebar -->
                <DockPanel Grid.Column="1" Background="{StaticResource PanelBrush}">
                    <Grid DockPanel.Dock="Top" Height="62" Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="HeaderImage" Width="32" Height="32" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderGlyph" FontFamily="{StaticResource IconFont}" FontSize="22" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="HeaderTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HeaderDetail" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="#1FFFFFFF" />
                    <Grid>
                        <ScrollViewer x:Name="SidebarScroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="SidebarRows" Margin="8" />
                        </ScrollViewer>
                        <TextBlock x:Name="SidebarEmpty" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                   Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
